# ===== LLM ("мозг", генерирует тексты ответов) =====
# Провайдер: anthropic | openai-compatible | mock
LLM_PROVIDER=anthropic

# --- если LLM_PROVIDER=anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# --- если LLM_PROVIDER=openai-compatible (любой сервер с /v1/chat/completions) ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ===== UI-TARS (GUI-агент, fallback-управление интерфейсом Yelp) =====
# Развернутая модель UI-TARS (HuggingFace endpoint / volcengine / vLLM).
# Если не заполнено — работает только быстрый DOM-режим (Playwright-селекторы).
UITARS_BASE_URL=
UITARS_API_KEY=
UITARS_MODEL=

# ===== Прочее =====
# Каталог с профилем браузера (сессия Yelp), состоянием и логами
DATA_DIR=./data
# Путь к конфигу бизнеса
BUSINESS_CONFIG=./config/business.yaml
# Порт дашборда
DASHBOARD_PORT=8377
# Headless-режим браузера (для сервера). Для login всегда открывается окно.
HEADLESS=false
